{
  "expo": {
    "name": "NexoPOS",
    "slug": "nexopos",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nexopos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linware.nexopos",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "NexoPOS usa Bluetooth para imprimir los tickets en la ticketera.",
        "NSLocalNetworkUsageDescription": "NexoPOS se conecta a la ticketera de la red del local para imprimir los tickets.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.linware.nexopos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/permiso-ubicacion",
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NexoPOS usa la cámara para leer los códigos de barras de los productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "NexoPOS usa Bluetooth para imprimir los tickets en la ticketera.",
          "neverForLocation": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/pods-deployment-target"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0dbc969-61aa-4d5a-854f-3dff8727f7af"
      }
    },
    "owner": "napy77"
  }
}
