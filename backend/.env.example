# Servidor
PORT=4000

# PostgreSQL (instancia dedicada del POS)
DATABASE_URL=postgres://nexopos:nexopos@localhost:5433/nexopos

# JWT emitido por el POS tras validar credenciales contra NexoB2B
JWT_SECRET=cambiar-en-produccion

# Integración NexoB2B (backend Medusa)
# Si NEXOB2B_API_URL está vacío, el POS corre en MODO MOCK:
# catálogo, mayoristas y órdenes simulados; login demo (cualquier email / "demo").
# Para producción:
#   NEXOB2B_API_URL=https://nexob2b.app
#   NEXOB2B_PUBLISHABLE_KEY=pk_...   (Medusa dashboard → Settings → API Keys → Publishable)
NEXOB2B_API_URL=
NEXOB2B_PUBLISHABLE_KEY=

# Dominio con el que se arman las URLs de logos e imágenes del marketplace
# (NexoB2B las guarda como rutas relativas: "/logos/x.jpg"). Solo hace falta
# si el backend habla con NexoB2B por una dirección distinta de la pública:
# quien descarga esas imágenes es el navegador del comercio, no el servidor.
# Por defecto usa NEXOB2B_API_URL.
NEXOB2B_PUBLIC_URL=

# ClubPay: descuentos para socios de clubes e instituciones.
# Vacío = modo demo, con socios de prueba (QR-SIMPLE, QR-TOPE, QR-MIERCOLES,
# QR-SIN-OFERTAS, QR-PLAN, QR-INACTIVO, QR-VENCIDO).
# En producción: CLUBPAY_API_URL=https://api.clubpay.com.ar
# La clave de POS es de cada comercio y se carga desde Configuración.
#
# Ojo con dejarlo vacío para probar el cobro por QR: el simulador da por
# escaneado el cobro a los pocos segundos y parece que anda, pero el QR lleva
# una URL de mentira que la app de ClubPay no abre. El circuito con el
# teléfono solo se prueba de verdad contra la API real.
CLUBPAY_API_URL=
